# Copy to .env to override defaults. All optional.
PORT=4173
HOST=0.0.0.0

# Path to the SQLite database file (relative to server/)
DB_PATH=data/ori.db

# Max concurrent WebSocket connections per IP (connection efficiency guard)
WS_MAX_PER_IP=8

# Heartbeat interval in ms (ping/pong keepalive)
WS_HEARTBEAT_MS=15000
